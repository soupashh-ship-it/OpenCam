<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows desktop target with WPF enabled so the probe decodes frames with
         the same JpegBitmapDecoder the UI uses. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>opencam-probe</AssemblyName>
    <RootNamespace>OpenCam.Probe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- The probe compiles the client's protocol and virtual camera sources
       directly, so it verifies the shipping implementation rather than a copy. -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="VirtualCameraBridge.cs" />
    <Compile Include="../OpenCam.Client/Protocol/*.cs" />
    <Compile Include="../OpenCam.Client/VirtualCamera/*.cs" />
  </ItemGroup>

</Project>
